; Engine configuration file.
; Big Head — iteration 1 (Scapegoat A.L. LLC)

config_version=5

[application]

config/name="Big Head"
config/description="Become a Big Head."
run/main_scene="res://scenes/splash.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")

[autoload]

Game="*res://scripts/autoload/game.gd"

[debug]

file_logging/enable_file_logging=true

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/per_pixel_transparency/allowed=true

[rendering]

; Compatibility renderer: the Steam overlay (achievement popups) does not
; show when running from the editor with Forward+.
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.08, 0.07, 0.1, 1)
